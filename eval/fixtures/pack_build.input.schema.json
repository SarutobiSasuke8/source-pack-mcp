{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "max_sources": {
      "default": 8,
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "query": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "search_depth": {
      "default": "quick",
      "enum": [
        "quick",
        "deep"
      ],
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "type": "object"
}
