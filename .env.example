# Maximum number of sources fetched into a single pack.
MAX_SOURCES_PER_PACK=8

# Per-request fetch timeout in milliseconds.
FETCH_TIMEOUT_MS=15000

# Minimum interval between outbound fetches (enforces max ~1 req/sec).
FETCH_MIN_INTERVAL_MS=1000

# Maximum response body size in bytes (default 5 MB). Larger responses fail
# with a RESPONSE_TOO_LARGE error.
FETCH_MAX_BODY_BYTES=5242880

# Optional: JSON search API for source discovery. When set, the server GETs
# `${SEARCH_API_URL}?q=<query>` and reads result URLs from the JSON response
# (results[].url / .link / .href, or a top-level url array). When unset,
# discovery falls back to scraping the DuckDuckGo HTML results page.
# SEARCH_API_URL=https://example.com/search

# User-Agent sent with every request.
# USER_AGENT=source-pack-mcp/0.1 (+https://github.com/SarutobiSasuke8/source-pack-mcp)

# Cache tuning for fetched pages (keyed by URL hash).
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600

# Directory where built packs are stored as JSON files.
PACKS_DIR=.packs

# HTTP transport bind (localhost by default).
HOST=127.0.0.1
PORT=3225
