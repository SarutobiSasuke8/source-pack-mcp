{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SarutobiSasuke8/source-pack-mcp",
  "title": "Source Pack MCP",
  "description": "Create structured research source packs with primary links and coverage evidence.",
  "repository": {
    "url": "https://github.com/SarutobiSasuke8/source-pack-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@sarutobi-sasuke/source-pack-mcp",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PACKS_DIR",
          "description": "Directory for source packs.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "CACHE_DIR",
          "description": "Directory for cached fetches.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
